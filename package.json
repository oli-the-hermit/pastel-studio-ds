{
  "name": "pastel-studio-ds",
  "private": true,
  "version": "0.1.0",
  "description": "Pastel Studio Design System: tokens, React components and documentation for the Pastel Studio app family.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "San Milano",
  "homepage": "https://github.com/oli-the-hermit/pastel-studio-ds#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oli-the-hermit/pastel-studio-ds.git"
  },
  "bugs": "https://github.com/oli-the-hermit/pastel-studio-ds/issues",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "docs": "npm run dev -w @pastel-studio/docs",
    "docs:build": "npm run build -w @pastel-studio/docs",
    "typecheck": "tsc -p packages/react --noEmit && tsc -p apps/docs --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"packages/**/*.css\" \"apps/**/*.css\"",
    "check:tokens": "node scripts/tokens/check.ts",
    "check:components": "node scripts/components/check.ts",
    "test": "vitest run",
    "visual:capture": "node scripts/visual/capture.ts",
    "visual:baseline": "node scripts/visual/capture.ts --out documentation/visual/baseline",
    "visual:diff": "node scripts/visual/diff.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run check:tokens && npm run check:components && npm run test && npm run docs:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.64.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylelint": "^17.15.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.4"
  }
}
